# ------------------------------------------------------------------
# Quartus build output.
#
# The reports are NOT ignored: docs/13-test-report.md and
# docs/14-latency-and-performance.md quote timing and utilisation
# numbers, and a reader has to be able to check them against the tool
# output in the same commit. Only the large regenerable databases go.
# ------------------------------------------------------------------
db/
incremental_db/
hps_isw_handoff/
output_files/*
!output_files/HFTTop.sof
# The .rbf matters more than the .sof: it is what the HPS uses to
# configure the fabric from Linux, which is the documented route and
# needs no USB-Blaster. Without it committed, a fresh clone cannot get
# past "deploy.py fpga" without installing Quartus - and the whole
# point of the container tooling is that you do not have to.
!output_files/HFTTop.rbf
!output_files/*.summary
!output_files/*.rpt
!output_files/*.pin

# Quartus per-user workspace state
*.qws
*.cdf
*.qws.*

# Platform Designer scratch
.qsys_edit/
*.sopcinfo.bak

# Mimosa security-scan state
.mimosa/

# Simulation
*.vvp
*.wlf
*.vcd
transcript
Testbenches/work/
Testbenches/build/

# HPS build products.  marketstream is cross-built (tools/crossbuild.sh),
# the two diagnostics build either on the board or in the cross image -
# all three are ARM binaries and none of them belongs in the history.
Software/marketstream
Software/market
Software/fmma-probe
Software/fmma-bench
Software/fmma-unittest
Software/*.o

# Measurement output from fmma-bench --csv
Software/*.csv

# Python
__pycache__/
*.pyc

# Never commit credentials. Alpaca keys belong in the environment;
# see docs/18-security-and-compliance.md.
.env
*.key
secrets.*

# Quartus EDA netlist writer output (regenerated by every compile)
simulation/

# Python bytecode from the tools
tools/__pycache__/

# Deploy staging area
build/

# Generated by the ISA conformance stage of run_sim.sh.
# isa_probe.asm is source and must NOT be matched here.
Software/isa_probe.hex
Software/isa_probe.bin
Software/isa_probe.h
Software/isa_probe.mif
Software/isa_probe.lst

# ModelSim/Questa leftovers, when someone uses those instead of iverilog
Testbenches/work*/
Testbenches/modelsim.ini
Testbenches/*.vvp
