set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY HFTTop
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "20:02:40  APRIL 16, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 6
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan

# ------------------------------------------------------------------ #
# Design files
#
# Software/HFTtop.v is the top level (Code/HFTtop.v is a synced
# copy kept for the archive - do NOT add both, Quartus would see
# two definitions of module HFTTop).
# ------------------------------------------------------------------ #
set_global_assignment -name QIP_FILE Software/HPSfgpa2/synthesis/HPSfgpa2.qip

# HPS SDRAM PHY library wrappers + the ST error adapter. These are
# normally emitted by qsys-generate, but this machine's Quartus
# install lacks the EMIF IP generation stack, so the generation
# aborts before writing them. The wrappers are version-stable IP
# library files (validated against the instantiations in
# hps_sdram.v); see Documents/BUILD-NOTES.md.
set_global_assignment -name SYSTEMVERILOG_FILE Software/HPSfgpa2/synthesis/submodules/altera_mem_if_hard_memory_controller_top_cyclonev.sv
set_global_assignment -name SYSTEMVERILOG_FILE Software/HPSfgpa2/synthesis/submodules/altera_mem_if_oct_cyclonev.sv
set_global_assignment -name SYSTEMVERILOG_FILE Software/HPSfgpa2/synthesis/submodules/altera_mem_if_dll_cyclonev.sv
set_global_assignment -name SYSTEMVERILOG_FILE Software/HPSfgpa2/synthesis/submodules/HPSfgpa2_mm_interconnect_0_avalon_st_adapter_error_adapter_0.sv
set_global_assignment -name SDC_FILE HFTTop.sdc
set_global_assignment -name VERILOG_FILE Software/HFTtop.v
set_global_assignment -name VERILOG_FILE Code/PC.v
set_global_assignment -name VERILOG_FILE Code/IR
set_global_assignment -name VERILOG_FILE Code/FR
set_global_assignment -name VERILOG_FILE Code/registerFinal
set_global_assignment -name VERILOG_FILE Code/MUX16to1
set_global_assignment -name VERILOG_FILE Code/MUX2to1
set_global_assignment -name VERILOG_FILE Code/ALUFinal
set_global_assignment -name VERILOG_FILE Code/FSMTrial
set_global_assignment -name VERILOG_FILE Code/disp
set_global_assignment -name VERILOG_FILE Code/Encoder4to16
set_global_assignment -name VERILOG_FILE Code/decoder.v

# ------------------------------------------------------------------ #
# DE1-SoC board pins (Cyclone V 5CSEMA5F31C6)
#
# The HPS DDR3 interface sits on dedicated HPS pins and is placed
# automatically by the HPS IP - no location assignments needed.
# ------------------------------------------------------------------ #
set_location_assignment PIN_AF14 -to CLOCK_50

set_location_assignment PIN_AE26 -to HEX0[0]
set_location_assignment PIN_AE27 -to HEX0[1]
set_location_assignment PIN_AE28 -to HEX0[2]
set_location_assignment PIN_AG27 -to HEX0[3]
set_location_assignment PIN_AF28 -to HEX0[4]
set_location_assignment PIN_AG28 -to HEX0[5]
set_location_assignment PIN_AH28 -to HEX0[6]

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to HEX0[6]

# ------------------------------------------------------------------ #
# HPS DDR3 I/O standards and termination (as Qsys emits for the
# hps_sdram_p0 interface; without these the pads default to 2.5 V
# and the fitter rejects the calibrated OCT connections).
# HPS SDRAM pins are dedicated - no location assignments needed.
