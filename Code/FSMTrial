// 
//Finite State Machine to handle all memins
//
////////////////////////////////////////////////
module FSMtrial(rst, clk, Ren, RI, PCen, displaceControl, memin, instruction, opcode, rSrc, rDst, Imm, Fen, IRen, LS, we, flags);

// Inputs
input clk;
input rst;
input [4:0] flags;
input [31:0] memin, instruction;

// Outputs
output reg Ren;
output reg [1:0] displaceControl;
output reg RI, PCen, Fen, IRen, LS, we;
output reg [3:0] opcode, rSrc, rDst;
output reg [31:0] Imm;   // 33 bits before; the top level
                         // only ever wired 32, so the extra bit was
                         // a silent truncation warning and nothing else

// Registers
reg [3:0] state;

// States
parameter S0 = 4'b0000; // Fetch 
parameter S1 = 4'b0001; // Decode
parameter S2 = 4'b0010; // R and I Type 
parameter S3 = 4'b0011; // Store Type
parameter S4 = 4'b0100; // Load Type 1
parameter S5 = 4'b0101; // Branch Type
parameter S6 = 4'b0110; // Jump Type
parameter hlt = 4'b1111; // Halt / wait-for-program state

always@(negedge clk) begin

    // Reset is active low. While asserted the FSM
    // stays in the fetch state (fixed: previously
    // the case statement overrode the reset).
    //
    // All outputs use non-blocking assignments: the
    // datapath registers (PC, IR, FR, reg bank) clock
    // on the same negedge and must sample the value
    // held for this cycle, not the half-updated one
    // (blocking assignments here caused a simulation
    // race that stalled the PC).
    // Defaults to prevent latches
    Ren <= 0;
    displaceControl <= 2'b00;
    RI <= 0;
    PCen <= 0;
    Fen <= 0;
    IRen <= 1;
    LS <= 0;
    we <= 0;
    opcode <= 4'b0000;
    rSrc <= 4'b0000;
    rDst <= 4'b0000;
    Imm <= 32'b00000000000000000000000000000000;

    if (!rst) begin
        state <= S0;
    end
    else begin
	
	case(state) 
	
	// Fetch
	S0: begin
		IRen <= 1;
		Ren <= 0;
		RI <= 0;
		LS <= 0;
		we <= 0;
		state <= S1;
	end
	
	// Decode
	S1: begin
		IRen <= 0;
		if(memin == 32'b00000000000000000000000000000000) begin
			state <= hlt;
		end
		else begin
			rDst <= memin[11:8];
			// If load, store, or jump
			if(memin[15:12] == 4'b0100) begin
				displaceControl <= 2'b01;
				// If store
				if(memin[7:4] == 4'b0100) begin
					rSrc <= memin[11:8];
					we <= 1;
					PCen <= 1;
					state <= S3;
				end
				// If load
				else if(memin[7:4] == 4'b0000) begin
					rSrc <= memin[3:0];
					Ren <= 1;
					PCen <= 1;
					LS <= 1;
					state <= S4;
				end
				// If jump
				else if(memin[7:4] == 4'b1100) begin
					PCen <= 1;
					displaceControl <= 2'b01;
					if(memin[11:8] == 4'b0000) begin
						if(flags[4] == 1'b1) displaceControl <= 2'b11;
					end
					else if(memin[11:8] == 4'b0001) begin
						if(flags[4] == 1'b0) displaceControl <= 2'b11;
					end
					else if(memin[11:8] == 4'b1101) begin
						if(flags[4] == 1'b1 || flags[0] == 1) displaceControl <= 2'b11;
					end
					else if(memin[11:8] == 4'b0110) begin
						if(flags[0] == 1'b1) displaceControl <= 2'b11;
					end
					else if(memin[11:8] == 4'b0111) begin
						if(flags[4] == 1'b1 || flags[0] == 1'b0) displaceControl <= 2'b11;
					end
					// Condition 1100 is deliberately not decoded: its
					// expression (!Z | !N) is true after every CMP, so it
					// would be an unconditional branch wearing a
					// conditional name. Use 0110 (LT) instead; the
					// assembler refuses to emit 1100.
					else if(memin[11:8] == 4'b1110) begin
						displaceControl <= 2'b11;
					end
					state <= S6;
				end
				// instr[7:4] is none of load/store/jump, so this is not a
				// valid encoding. Park in the halt state rather than leaving
				// 'state' unassigned, which stalled the FSM in decode with no
				// way out and no indication of why.
				else begin
					state <= hlt;
				end
			end
			// If branch type
			else if(memin[15:12] == 4'b1100) begin
				PCen <= 1;
				displaceControl <= 2'b01;
				if(memin[11:8] == 4'b0000) begin
					if(flags[4] == 1'b1) displaceControl <= 2'b10;
				end
				else if(memin[11:8] == 4'b0001) begin
					if(flags[4] == 1'b0) displaceControl <= 2'b10;
				end
				else if(memin[11:8] == 4'b1101) begin
					if(flags[4] == 1'b1 || flags[0] == 1) displaceControl <= 2'b10;
				end
				else if(memin[11:8] == 4'b0110) begin
					if(flags[0] == 1'b1) displaceControl <= 2'b10;
				end
				else if(memin[11:8] == 4'b0111) begin
					if(flags[4] == 1'b1 || flags[0] == 1'b0) displaceControl <= 2'b10;
				end
				// Condition 1100 is deliberately not decoded: its
				// expression (!Z | !N) is true after every CMP, so it
				// would be an unconditional branch wearing a
				// conditional name. Use 0110 (LT) instead; the
				// assembler refuses to emit 1100.
				else if(memin[11:8] == 4'b1110) begin
					displaceControl <= 2'b10;
				end
				state <= S5;
			end
			// If RI Type
			else begin
				Imm <= {8'b00000000, memin[31:16], memin[7:0]};
				// If R to R
				if(memin[15:12] == 4'b0000) begin
					rSrc <= memin[3:0];
					RI <= 0;
					opcode <= memin[7:4];
					// CMP has no register writeback - decide from the
					// decoded opcode, the opcode register still holds
					// the previous instruction here
					if(memin[7:4] != 4'b1011) Ren <= 1;
				end
				
				// If R to I
				else begin
					rSrc <= memin[11:8];
					RI <= 1;
					opcode <= memin[15:12];
					if(memin[15:12] != 4'b1011) Ren <= 1;
				end
					
				displaceControl <= 2'b01;
				PCen <= 1;
				Fen <= 1;
				state <= S2;
			end
		end
	end

	// R and I type
	S2: begin
		PCen <= 0;
		Ren <= 0;
		Fen <= 0;
		IRen <= 0;
		
		state <= S0;
	end
	
	// Store type
	S3: begin
		PCen <= 0;
		Ren <= 0;
		Fen <= 0;
		IRen <= 0;
		LS <= 0;
		we <= 0;
		
		state <= S0;
	end
	
	// Load Type Set Memory Address
	S4: begin
		PCen <= 0;
		Ren <= 0;
		Fen <= 0;
		IRen <= 0;
		LS <= 0;
		we <= 0;
		
		state <= S0;
	end
	
	// Branch Type
	S5: begin
		PCen <= 0;
		Ren <= 0;
		Fen <= 0;
		IRen <= 0;
		LS <= 0;
		we <= 0;
		
		state <= S0;
	end
	
	// Jump Type
	S6: begin
		PCen <= 0;
		Ren <= 0;
		Fen <= 0;
		IRen <= 0;
		LS <= 0;
		we <= 0;
		
		state <= S0;
	end
	
	// Halt / wait-for-program state.
	// The shared RAM powers up zeroed, so after
	// FPGA configuration the fetched instruction
	// is 32'b0 and the CPU parks here. The HPS
	// loader writes the program over the LW bridge;
	// as soon as the word at the PC is non-zero the
	// CPU decodes it and resumes execution. This
	// also re-syncs automatically if the loader is
	// still filling in later program words.
	hlt: begin
		if (memin != 32'b00000000000000000000000000000000)
			state <= S1;
		else
			state <= hlt;
	end
	
	endcase
	
	end
	
end
endmodule
