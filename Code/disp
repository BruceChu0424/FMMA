////////////////////////////////////////////////
// FMMA - FPGA Market Maker Accelerator
//
// PC displacer: computes the next PC value.
//
// control 00 : hold
// control 01 : PC + 1 (sequential)
// control 10 : PC + disp (branch - the displacement is
//              SIGNED, so backward branches work)
// control 11 : addr (absolute jump through a register)
////////////////////////////////////////////////

module Disp(PCold, control, PCnew, disp, addr);

input [9:0] PCold, addr;
input [1:0] control;
input [7:0] disp;
output reg [9:0] PCnew;
always @(*) begin

    case(control)
    2'b00: begin 
        PCnew  = PCold;
    end

    2'b01: begin 
        PCnew  = PCold + 10'b0000000001;
    end
	 
	 2'b10: begin 
        // sign-extend the 8-bit displacement to 10 bits
        // (previously the unsigned addition turned backward
        // branches into large forward jumps)
        PCnew  = PCold + {{2{disp[7]}}, disp};
    end
	 
	 2'b11: begin 
        PCnew  = addr;
    end
	 
	 default: begin
		PCnew = 10'b0000000000;
	 end
    endcase
end

endmodule
