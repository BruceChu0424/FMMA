module register(in, enable, rst, clk, out);

// Input for the in value of the reg
input [31:0] in;
// Inputs to enable the reg, rst the reg, and a clk to run on
input enable, clk, rst;

// An output for the out value
output reg [31:0] out;

// Always run of the negative edge of the clk
always @(negedge clk)
    begin
        // If rst is set, rst the reg to 0

		// non blocking assignment for sequential 
        if(rst) out <= 32'd0;

        // If the enable is on, set the output of the register to the input
        else begin
            if(enable) out <= in;
        end
    end

endmodule

