// ECE 3710
// Group 1011
// October 27, 2025
// 
// ALU Design
//
// Implemented operations (opcode -> mnemonic):
//   1 AND    2 OR     3 XOR    5 ADD    6 ADDU
//   7 ADDC   8 LSH    9 SUB    A SUBC   B CMP
//   D ASH    E MUL    F MOV
// Anything else falls through to the default arm, which returns 0
// with the flags cleared.
//
// Flag semantics are meaningful for ADD/ADDU/ADDC/SUB/SUBC/CMP only.
// The logical operations, MOV and MUL leave Flags at 0, and because
// the control FSM asserts Fen for the whole R/I-type class that
// *clears* the flag register - so a compare result does not survive
// an intervening MOV.  Put a CMP immediately before its branch.
//
// See docs/04-isa-reference.md for the full table.
////////////////////////////////////////////////
module ALUFinal( A, B, C, Opcode, Cin, Flags);

// Inputs
input [31:0] A, B;
input [3:0] Opcode;
input Cin;


// Outputs
// Order of Flags 
// Flags[4] = Z, Zero Flag
// Flags[3] = C, Carry Flag
// Flags[2] = F, Overflow Flag 
// Flags[1] = L, Low Flag (Less than unsigned)
// Flags[0] = N, Negative Flag
output reg [31:0] C;
output reg [4:0] Flags;

integer i;
// 1100 =Branch
// 0100 = L/S and jcond
// 0000 = R to R
// other = I instructions

// Parameters


// 0000 R to R
parameter AND = 4'b0001; 
parameter OR = 4'b0010; 
parameter XOR = 4'b0011; 
// 0100 L and S
parameter ADD = 4'b0101;
parameter ADDU = 4'b0110;
parameter ADDC = 4'b0111;
parameter LSH = 4'b1000;
parameter SUB = 4'b1001;
parameter SUBC = 4'b1010;
parameter CMP = 4'b1011;
// 1100 Branch
parameter ASH = 4'b1101; // different from isa

// ADDCU is not on the ISA	
//parameter ADDCU = 4'b1001;
parameter MUL = 4'b1110;
parameter MOV = 4'b1111; //Different from isa
// NOT is not an op
// could implement mov 
// parameter RSH = 4'b0111;
// right shift not operation

// missing subC



//parameter NOP = 4'b1010;



reg [31:0] BCin, diff;
reg [4:0] shift;

always @(Opcode, A, B, Cin)
begin
	 i = 0;
    C = 32'd0;
    Flags = 5'b00000;
	case (Opcode)
		ADDU: begin
			BCin = 32'd0;
			shift = 5'd0;
			i = 0;
			{Flags[3], C} = A + B;
			if (C == 32'd0) Flags[4] = 1'b1;
			else Flags[4] = 1'b0;
		end
		
		ADD: begin
			BCin = 32'd0;
			shift = 5'd0;
			i = 0;
			C = A + B;
			if (C == 32'd0) Flags[4] = 1'b1;
			else Flags[4] = 1'b0;
			if( (~A[31] & ~B[31] & C[31]) | (A[31] & B[31] & ~C[31]) ) Flags[2] = 1'b1;
			else Flags[2] = 1'b0;
            Flags[0] = C[31];
			
		end
		
		ADDC: begin
			shift = 5'd0;
			i = 0;
			{Flags[3], C} = {1'b0, A} + {1'b0, B} + {32'b0, Cin};
			if (C == 32'd0) Flags[4] = 1'b1;
			else Flags[4] = 1'b0;
            BCin = B + {31'd0, Cin};
			if( (~A[31] & ~BCin[31] & C[31]) | (A[31] & BCin[31] & ~C[31]) ) Flags[2] = 1'b1;
			else Flags[2] = 1'b0;
            Flags[0] = C[31];
		
		end
		
		SUB: begin
			BCin = 32'd0;
			shift = 5'd0;
			i = 0;
			C = A - B;
			if (C == 32'd0) Flags[4] = 1'b1;
			else Flags[4] = 1'b0;
            if(A < B) Flags[3] = 1'b0;          // borrow-inverted carry
            else Flags[3] = 1'b1;
			if( (A[31] ^ B[31]) & (A[31] ^ C[31]) ) Flags[2] = 1'b1;
			else Flags[2] = 1'b0;
			// SUB previously left L and N at zero, so a SUB followed by
			// a conditional branch could never take it.  Use CMP before
			// a branch if the operands can overflow: N here is the sign
			// of the difference, which differs from "A < B" exactly when
			// the subtraction overflows.
			Flags[1] = (A < B);                 // L, unsigned
			Flags[0] = C[31];                   // N, sign of the result
		end
		
        SUBC: begin 
		  
			shift = 5'd0;
			BCin = B + {31'd0, ~Cin};
			i = 0;
            C = A - BCin;
			if (C == 32'd0) Flags[4] = 1'b1;
			else Flags[4] = 1'b0;
            // Same borrow-inverted polarity as SUB; this used to be
            // the other way round, so SUB and SUBC disagreed about
            // what the carry flag meant.
            if(A < BCin) Flags[3] = 1'b0;
            else Flags[3] = 1'b1;

            if( (A[31] ^ BCin[31]) & (A[31] ^ C[31]) ) Flags[2] = 1'b1;
			else Flags[2] = 1'b0;
			Flags[1] = (A < BCin);              // L, unsigned
			Flags[0] = C[31];                   // N, sign of the result
        end

		// Flags[4] = Z, Zero Flag
		// Flags[3] = C, Carry Flag
		// Flags[2] = F, Overflow Flag 
		// Flags[1] = L, Low Flag (Less than unsigned)
		// Flags[0] = N, Negative Flag
		// CMP produces no result, only flags.  N is the signed
		// less-than every conditional branch is built on; L is the
		// unsigned one.  The previous version derived both from a
		// sign-compare chain that got L wrong whenever the operands
		// had different signs (a positive A against a negative B is
		// unsigned-less-than, but the chain reported 0).
		CMP: begin
			BCin = 32'd0;
			shift = 5'd0;
			i = 0;
			Flags = 5'b00000;
			if (A == B) Flags[4] = 1'b1;                       // Z
			Flags[1] = (A < B);                                // L, unsigned
			Flags[0] = ($signed(A) < $signed(B));              // N, signed
		end
		
		AND: begin
			BCin = 32'd0;
			shift = 5'd0;
			i = 0;
			C = A & B;
		end
		
		OR: begin
			BCin = 32'd0;
			shift = 5'd0;
			i = 0;
			C = A | B;
		end

		
		XOR: begin
			BCin = 32'd0;
			shift = 5'd0;
			i = 0;
			C = A ^ B;
		end
		
		
		
		
		// The shift amount is a SIGNED 5-bit value in B[4:0]:
		// positive shifts left, negative shifts right.  B[4] is its
		// sign, so the magnitude of a right shift is the two's
		// complement of the low five bits.
		//
		// The previous implementation always performed the left shift
		// and then, whenever the negated count happened to land at 15
		// or below, performed a second right shift on the already
		// shifted value.  The result was correct only for counts 1..16;
		// a count of 0 returned A >> 1 and every negative count
		// returned (A << n) >> k instead of A >> (32 - n).
		LSH: begin
			BCin = 32'd0;
			i = 0;
			shift = B[4] ? (~B[4:0] + 5'b00001) : B[4:0];
			if (B[4] == 1'b0) C = A << B[4:0];      // left
			else              C = A >> shift;       // logical right
		end

		ASH: begin
			BCin = 32'd0;
			i = 0;
			shift = B[4] ? (~B[4:0] + 5'b00001) : B[4:0];
			if (B[4] == 1'b0) C = A <<< B[4:0];     // left
			else              C = $signed(A) >>> shift;   // arithmetic right
		end
	
		
		
		
		
      MUL: begin
			BCin = 32'd0;
			shift = 5'd0;
			i = 0;
         C = A * B;
        end

		MOV: begin
			BCin = 32'd0;
			shift = 5'd0;
			i = 0;
			C = B;
		end
        default: begin
				BCin = 32'd0;
				shift = 5'd0;
				i = 0;
            C = C;
            Flags = 5'b00000;
        end

		
	endcase
end



endmodule
